{
  "name": "@dev-guard/cli",
  "version": "0.8.2",
  "private": false,
  "description": "CLI context guard for AI coding session continuity, handoff, and next-session recovery.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projectbom/dev-guard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/projectbom/dev-guard#readme",
  "bugs": {
    "url": "https://github.com/projectbom/dev-guard/issues"
  },
  "keywords": [
    "ai",
    "codex",
    "claude",
    "handoff",
    "cli",
    "developer-tools"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dev-guard": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsc -b && node dist/index.js",
    "cli": "node dist/index.js",
    "test": "tsc -b && node --test test/**/*.test.js"
  },
  "dependencies": {
    "@dev-guard/core": "0.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "zod": "3"
  }
}
