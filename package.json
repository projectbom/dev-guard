  },
  "homepage": "https://github.com/projectbom/dev-guard#readme",
  "bugs": {
    "url": "https://github.com/projectbom/dev-guard/issues"
  },
  "keywords": [
    "ai",
    "codex",
    "claude",
    "handoff",
    "cli",
    "developer-tools"
  ],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @dev-guard/cli dev",
    "cli": "pnpm --filter @dev-guard/cli cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
